# Key names read from .localEnv.agent (repo root, git-ignored) by the tier 3 stack. Names only, never real values.
# Staging image repository of cms-api (without tag).
TIER3_API_IMAGE_REPO=
# Staging image repository of web (without tag).
TIER3_WEB_IMAGE_REPO=
# Staging image repository of cms-admin (without tag).
TIER3_ADMIN_IMAGE_REPO=
# Optional: cms-api image tag; default is the staging overlay tag.
TIER3_API_IMAGE_TAG=
# Optional: web image tag; default is the staging overlay tag.
TIER3_WEB_IMAGE_TAG=
# Optional: cms-admin image tag; default is the staging overlay tag.
TIER3_ADMIN_IMAGE_TAG=
# Optional: registry host that needs a pull Secret.
TIER3_REGISTRY_SERVER=
# Optional: registry user for the pull Secret.
TIER3_REGISTRY_USERNAME=
# Optional: registry token for the pull Secret.
TIER3_REGISTRY_TOKEN=
